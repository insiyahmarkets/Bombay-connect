{
  "name": "netcompare-server",
  "version": "1.0.0",
  "description": "NetCompare backend - Internet Quality Pilot Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec \"ts-node src/index.ts\" --ext ts",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/seedDemo.js",
    "db:reset": "node scripts/resetDb.js",
    "test": "node scripts/testApi.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.11",
    "@types/sqlite3": "^3.1.11",
    "localtunnel": "^2.0.2",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
